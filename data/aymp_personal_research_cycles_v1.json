      "time": "",
      "place": "",
      "timezone": "",
      "latitude": null,
      "longitude": null,
      "lagna": "",
      "ascendant_degree": null
    },
    "concern": {
      "key": "",
      "label": ""
    },
    "planetary_focus": [],
    "yantra_research_id": "",
    "herb_research_ids": [],
    "mantra_research_id": "",
    "guidance_schedule": [],
